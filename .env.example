# CaféMeeple — Environment Variables
# Copy this file to .env.local and adjust values for your environment.

# Database
# SQLite database file path (relative to project root).
# Default: cafemeeple.db
# DB_PATH=cafemeeple.db

# Server
# Port for the Next.js dev server (default: 3000).
# PORT=3000

# Application
# Base URL used for absolute links and OG meta tags.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
